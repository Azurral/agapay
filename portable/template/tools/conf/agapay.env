APP_NAME=AGAPAY
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=http://localhost:8742
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=agapay
DB_USERNAME=agapay
DB_PASSWORD={{DB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=30
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# "Update available" for the Administrator, from GitHub releases.
AGAPAY_UPDATES=true
AGAPAY_UPDATE_REPOSITORY=Azurral/agapay

# Used only by the backup, restore and stop tools (not by AGAPAY itself).
AGAPAY_DB_ROOT_PASSWORD={{DB_ROOT_PASSWORD}}
