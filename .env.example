APP_NAME=Agapay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agapay
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AGAPAY_SEED_PASSWORD=Agapay@2026

# ---- Cloud copy only (the Docker image sets AGAPAY_EDITION=cloud, TRUSTED_PROXIES=*, SESSION_LIFETIME=30) ----
# AGAPAY_EDITION=cloud
# TRUSTED_PROXIES=*
# Damage photos and reports: 'local' (a persistent volume on storage/) or 's3' (the AWS_* settings above).
# AGAPAY_FILES_DISK=local
# Demo copies only: load the sample records and test accounts on the first start.
# AGAPAY_SAMPLE_DATA=true
# 3-2-1 backups: the zip password (keep it outside the server too!) and the off-site S3-compatible bucket.
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_OFFSITE_KEY=
# BACKUP_OFFSITE_SECRET=
# BACKUP_OFFSITE_REGION=auto
# BACKUP_OFFSITE_BUCKET=
# BACKUP_OFFSITE_ENDPOINT=

# Only used by `npm run visual` (tests/visual); leave empty everywhere else.
AGAPAY_FROZEN_NOW=
